# Local development defaults matching docker-compose.yml.
# Do not use these values in production.
# Copy to .env.local (development) or .env.production (deploy) and fill in values.
# Keep secrets out of version control; this file is committed as a template.
# cp .env.example .env.local

# PostgreSQL credentials
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_PASSWORD=test-password
DB_NAME=app

# Session secret for hashing session tokens in database
SESSION_SECRET=local-development-secret
